# ============================================================
# LLMwiki backend — production .env template
# Deploy to: /www/wwwroot/llmwiki/backend/.env
# Permissions: 0600 (chmod 600 .env)
# ============================================================

# --- Vault (on server) ---
LLMWIKI_VAULT_ROOT=/www/vault/政策

# --- LLM (must be set, NOT auto-loaded from settings.json on server) ---
LLMWIKI_LLM_API_KEY=sk-cp-YOUR_KEY_HERE
LLMWIKI_LLM_BASE_URL=https://api.minimaxi.com/anthropic
LLMWIKI_LLM_MODEL=MiniMax-M3
LLMWIKI_LLM_MAX_TOKENS=8192
LLMWIKI_LLM_REQUEST_TIMEOUT=300
LLMWIKI_LLM_MAX_TOOL_ITERATIONS=8

# --- Server ---
LLMWIKI_HOST=127.0.0.1
LLMWIKI_PORT=8000
LLMWIKI_DEBUG=false
# CORS: same-origin (no CORS needed in prod). Leave empty to disable.
# LLMWIKI_CORS_ORIGINS=

# --- Sessions / Tools ---
LLMWIKI_SESSION_MAX_MESSAGES=40
LLMWIKI_TOOL_RESULT_MAX_BYTES=4096
LLMWIKI_SKILL_DESCRIPTION_MAX_CHARS=100
LLMWIKI_SCRIPT_TIMEOUT_SECONDS=60

# --- Claude Code settings.json path (set to /dev/null on server if N/A) ---
# LLMWIKI_CLAUDE_SETTINGS_PATH=/dev/null
