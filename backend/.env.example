# ============================================================
# LLMwiki backend — local dev .env example
# ============================================================
# Copy to .env and edit. ALL fields are optional.
# Empty LLM_API_KEY → backend will auto-load from your Claude Code
#   settings.json (env.ANTHROPIC_AUTH_TOKEN) — set
#   LLMWIKI_CLAUDE_SETTINGS_PATH below to its location.
# ============================================================

# --- Vault ---
# Path to your local Obsidian vault.
LLMWIKI_VAULT_ROOT=/path/to/your/obsidian-vault

# --- Claude Code settings.json (auto-loads LLM_API_KEY from it) ---
# Windows example: C:/Users/<you>/.claude/settings.json
# macOS / Linux example: /home/<you>/.claude/settings.json
# Set to /dev/null on a server to disable auto-loading.
LLMWIKI_CLAUDE_SETTINGS_PATH=/path/to/claude/settings.json

# --- LLM (override defaults from settings.json) ---
# Leave blank to auto-load from Claude Code settings.json.
LLMWIKI_LLM_API_KEY=
LLMWIKI_LLM_BASE_URL=https://api.minimaxi.com/anthropic
LLMWIKI_LLM_MODEL=MiniMax-M3
LLMWIKI_LLM_MAX_TOKENS=8192
LLMWIKI_LLM_REQUEST_TIMEOUT=300
LLMWIKI_LLM_MAX_TOOL_ITERATIONS=8

# --- Server ---
LLMWIKI_HOST=127.0.0.1
LLMWIKI_PORT=8000
LLMWIKI_DEBUG=false

# --- Sessions ---
LLMWIKI_SESSION_MAX_MESSAGES=40

# --- Tool / prompt tuning ---
LLMWIKI_TOOL_RESULT_MAX_BYTES=4096
LLMWIKI_SKILL_DESCRIPTION_MAX_CHARS=100

# --- Whitelisted scripts ---
LLMWIKI_SCRIPT_TIMEOUT_SECONDS=60
